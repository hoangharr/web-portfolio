server {
    server_name hoangdm.com www.hoangdm.com;
    root /home/ubuntu/web-portfolio;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PWA: không cache service worker và manifest
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.json {
        add_header Cache-Control "no-cache";
    }

    # Hash assets (img/css/js): cache dài hạn
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA: mọi route không tồn tại -> index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/hoangdm.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hoangdm.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.hoangdm.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = hoangdm.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name hoangdm.com www.hoangdm.com;
    return 404; # managed by Certbot




}
